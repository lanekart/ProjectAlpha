//@version=6
strategy("Alpha TRL 01 Indicator Weight Ablation Lab v2.0", overlay=true, initial_capital=1000000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.10, slippage=1, pyramiding=0, process_orders_on_close=true)

// DATA SOURCE: TRADINGVIEW
// NOT ALPHA MARKET TRUTH ENGINE
// CORPORATE-ACTION AND SYMBOL-HISTORY SEMANTICS MAY DIFFER
// RESULTS ARE INDEPENDENT VALIDATION, NOT AUTHORITATIVE ALPHA REPLAY
// RESEARCH PURPOSE ONLY. THIS SCRIPT DOES NOT PRODUCE ALPHA RECOMMENDATIONS.

startDate = input.time(timestamp("01 Jan 2015 00:00 +0000"), "Start date", group="Research Window")
endDate = input.time(timestamp("31 Dec 2035 23:59 +0000"), "End date", group="Research Window")
researchPartition = input.string("DEVELOPMENT", "Research partition", options=["DEVELOPMENT", "VALIDATION", "HOLDOUT"], group="Research Window")
orderSize = input.float(10.0, "Order size (% of equity)", minval=0.1, maxval=100.0, group="Backtest Controls")
commission = input.float(0.10, "Commission (%) (declaration fixed)", minval=0.0, group="Backtest Controls")
slippage = input.int(1, "Slippage (ticks) (declaration fixed)", minval=0, group="Backtest Controls")
longOnly = input.bool(true, "Long only", group="Backtest Controls")
nextBarExecution = input.bool(true, "Next-bar execution", group="Backtest Controls")
conflictPolicy = input.string("STOP_FIRST_CONSERVATIVE", "Same-bar conflict policy", options=["STOP_FIRST_CONSERVATIVE"], group="Backtest Controls")
tradingSession = input.session("0915-1530", "Trading session", group="Backtest Controls")

useEmaTrend = input.bool(true, "EMA Trend", group="Indicator Toggles")
useSmaTrend = input.bool(true, "SMA Trend", group="Indicator Toggles")
useVwap = input.bool(false, "VWAP", group="Indicator Toggles")
useRelativeVolume = input.bool(true, "Relative Volume", group="Indicator Toggles")
useVolumeMa = input.bool(true, "Volume MA", group="Indicator Toggles")
useAdx = input.bool(false, "ADX", group="Indicator Toggles")
useRsi = input.bool(false, "RSI", group="Indicator Toggles")
useMacd = input.bool(false, "MACD", group="Indicator Toggles")
useAtr = input.bool(true, "ATR", group="Indicator Toggles")
usePriceStructure = input.bool(true, "Price Structure", group="Indicator Toggles")
useRelativeStrength = input.bool(true, "Relative Strength", group="Indicator Toggles")
useCandlestick = input.bool(true, "Candlestick Engine", group="Indicator Toggles")
useBreakout = input.bool(true, "Breakout Engine", group="Indicator Toggles")
useRetracement = input.bool(true, "Retracement", group="Indicator Toggles")
useSupport = input.bool(true, "Support", group="Indicator Toggles")
useResistance = input.bool(true, "Resistance", group="Indicator Toggles")
benchmarkSymbol = input.symbol("NSE:NIFTY", "Relative strength benchmark", group="Indicator Toggles")

ablation = input.string("BASELINE", "Component ablation", options=["BASELINE", "REMOVE_TREND", "REMOVE_VOLUME", "REMOVE_RELATIVE_STRENGTH", "REMOVE_RETRACEMENT", "REMOVE_CANDLES", "REMOVE_BREAKOUT", "REMOVE_RISK"], group="Component Ablation")
priceWeight = input.float(20.0, "Price structure weight", minval=0.0, maxval=100.0, group="Component Weights")
volumeWeight = input.float(17.0, "Volume weight", minval=0.0, maxval=100.0, group="Component Weights")
trendWeight = input.float(15.0, "Trend weight", minval=0.0, maxval=100.0, group="Component Weights")
relativeStrengthWeight = input.float(13.0, "Relative strength weight", minval=0.0, maxval=100.0, group="Component Weights")
retracementWeight = input.float(10.0, "Retracement weight", minval=0.0, maxval=100.0, group="Component Weights")
candleWeight = input.float(8.0, "Candle weight", minval=0.0, maxval=100.0, group="Component Weights")
breakoutWeight = input.float(7.0, "Breakout weight", minval=0.0, maxval=100.0, group="Component Weights")
riskWeight = input.float(2.0, "Risk weight", minval=0.0, maxval=100.0, group="Component Weights")
otherWeight = input.float(8.0, "Other Alpha evidence weight", minval=0.0, maxval=100.0, group="Component Weights")
entryThreshold = input.float(75.0, "Research entry threshold", minval=0.0, maxval=100.0, group="Component Weights")

baselineAvailable = input.bool(false, "Alpha baseline metrics available", group="Baseline Comparison")
baselineProfitFactor = input.float(1.0, "Alpha baseline profit factor", minval=0.0, group="Baseline Comparison")
baselineExpectancy = input.float(0.0, "Alpha baseline expectancy", group="Baseline Comparison")
baselineDrawdown = input.float(0.0, "Alpha baseline max drawdown (%)", minval=0.0, group="Baseline Comparison")

safeDiv(float numerator, float denominator, float fallback) => denominator == 0.0 or na(denominator) ? fallback : numerator / denominator
inWindow = time >= startDate and time <= endDate
inSession = not na(time(timeframe.period, tradingSession))
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
sma20 = ta.sma(close, 20)
sma50 = ta.sma(close, 50)
vwapValue = ta.vwap(hlc3)
volumeAverage = ta.sma(volume, 20)
relativeVolume = safeDiv(volume, volumeAverage, 1.0)
[plusDi, minusDi, adxValue] = ta.dmi(14, 14)
rsiValue = ta.rsi(close, 14)
[macdLine, signalLine, macdHistogram] = ta.macd(close, 12, 26, 9)
atrValue = ta.atr(14)
resistanceValue = ta.highest(high[1], 50)
supportValue = ta.lowest(low[1], 50)
benchmarkClose = request.security(benchmarkSymbol, timeframe.period, close, lookahead=barmerge.lookahead_off)
relativeStrengthLine = safeDiv(close, benchmarkClose, 1.0)
relativeStrengthAverage = ta.sma(relativeStrengthLine, 20)
closeStrength = safeDiv(close - low, high - low, 0.5)
higherStructure = high > high[1] and low > low[1]
bullishCandle = close > open and closeStrength >= 0.65
breakoutCondition = close > resistanceValue and relativeVolume >= 1.20
healthyRetracement = low <= ema20 and close >= ema20 and relativeVolume <= 1.0
supportHeld = close >= supportValue and low >= supportValue - atrValue * 0.25
resistanceCleared = close > resistanceValue
riskQuality = atrValue > 0.0 and safeDiv(atrValue, close, 1.0) <= 0.05

trendChecks = (useEmaTrend ? 1 : 0) + (useSmaTrend ? 1 : 0) + (useVwap ? 1 : 0) + (useAdx ? 1 : 0) + (useRsi ? 1 : 0) + (useMacd ? 1 : 0)
trendPasses = (useEmaTrend and close > ema20 and ema20 > ema50 ? 1 : 0) + (useSmaTrend and close > sma20 and sma20 > sma50 ? 1 : 0) + (useVwap and close > vwapValue ? 1 : 0) + (useAdx and adxValue >= 20.0 and plusDi > minusDi ? 1 : 0) + (useRsi and rsiValue >= 50.0 and rsiValue <= 75.0 ? 1 : 0) + (useMacd and macdLine > signalLine and macdHistogram > 0.0 ? 1 : 0)
trendScore = trendChecks == 0 ? 50.0 : trendPasses * 100.0 / trendChecks
volumeChecks = (useRelativeVolume ? 1 : 0) + (useVolumeMa ? 1 : 0)
volumePasses = (useRelativeVolume and relativeVolume >= 1.20 ? 1 : 0) + (useVolumeMa and volume > volumeAverage ? 1 : 0)
volumeScore = volumeChecks == 0 ? 50.0 : volumePasses * 100.0 / volumeChecks
priceChecks = (usePriceStructure ? 1 : 0) + (useSupport ? 1 : 0) + (useResistance ? 1 : 0)
pricePasses = (usePriceStructure and higherStructure ? 1 : 0) + (useSupport and supportHeld ? 1 : 0) + (useResistance and resistanceCleared ? 1 : 0)
priceScore = priceChecks == 0 ? 50.0 : pricePasses * 100.0 / priceChecks
relativeStrengthScore = not useRelativeStrength ? 50.0 : relativeStrengthLine > relativeStrengthAverage ? 100.0 : 0.0
retracementScore = not useRetracement ? 50.0 : healthyRetracement ? 100.0 : 0.0
candleScore = not useCandlestick ? 50.0 : bullishCandle ? 100.0 : 0.0
breakoutScore = not useBreakout ? 50.0 : breakoutCondition ? 100.0 : 0.0
riskScore = not useAtr ? 50.0 : riskQuality ? 100.0 : 0.0
activeTrendWeight = ablation == "REMOVE_TREND" ? 0.0 : trendWeight
activeVolumeWeight = ablation == "REMOVE_VOLUME" ? 0.0 : volumeWeight
activeRelativeStrengthWeight = ablation == "REMOVE_RELATIVE_STRENGTH" ? 0.0 : relativeStrengthWeight
activeRetracementWeight = ablation == "REMOVE_RETRACEMENT" ? 0.0 : retracementWeight
activeCandleWeight = ablation == "REMOVE_CANDLES" ? 0.0 : candleWeight
activeBreakoutWeight = ablation == "REMOVE_BREAKOUT" ? 0.0 : breakoutWeight
activeRiskWeight = ablation == "REMOVE_RISK" ? 0.0 : riskWeight
totalWeight = priceWeight + activeVolumeWeight + activeTrendWeight + activeRelativeStrengthWeight + activeRetracementWeight + activeCandleWeight + activeBreakoutWeight + activeRiskWeight + otherWeight
weightedEvidence = priceScore * priceWeight + volumeScore * activeVolumeWeight + trendScore * activeTrendWeight + relativeStrengthScore * activeRelativeStrengthWeight + retracementScore * activeRetracementWeight + candleScore * activeCandleWeight + breakoutScore * activeBreakoutWeight + riskScore * activeRiskWeight + 50.0 * otherWeight
compositeScore = safeDiv(weightedEvidence, totalWeight, 0.0)

entrySignalNow = compositeScore >= entryThreshold and close > ema20 and not (close < ema50 and relativeVolume >= 1.30)
entrySignal = nextBarExecution ? entrySignalNow[1] : entrySignalNow
selectedStop = math.min(close - syminfo.mintick, math.max(syminfo.mintick, math.max(supportValue, ema50) - atrValue * 0.50))
riskPerShare = close - selectedStop
selectedTarget = close + riskPerShare * 2.0
calculatedQuantity = strategy.equity * orderSize / 100.0 / close
if inWindow and inSession and longOnly and entrySignal and riskPerShare > 0.0 and strategy.position_size == 0
    strategy.entry("TRL Indicator Long", strategy.long, qty=calculatedQuantity)
if strategy.position_size > 0
    strategy.exit("TRL Indicator Exit", "TRL Indicator Long", stop=selectedStop, limit=selectedTarget)

var float equityPeak = 1000000.0
var float maximumDrawdown = 0.0
equityPeak := math.max(equityPeak, strategy.equity)
currentDrawdown = equityPeak <= 0.0 ? 0.0 : (equityPeak - strategy.equity) / equityPeak * 100.0
maximumDrawdown := math.max(maximumDrawdown, currentDrawdown)
closedTrades = strategy.closedtrades
winRate = closedTrades == 0 ? na : strategy.wintrades / closedTrades * 100.0
profitFactor = strategy.grossloss == 0.0 ? na : strategy.grossprofit / math.abs(strategy.grossloss)
averageWinner = strategy.wintrades == 0 ? na : strategy.grossprofit / strategy.wintrades
averageLoser = strategy.losstrades == 0 ? na : math.abs(strategy.grossloss) / strategy.losstrades
expectancy = na(winRate) or na(averageWinner) or na(averageLoser) ? na : winRate / 100.0 * averageWinner - (1.0 - winRate / 100.0) * averageLoser
netReturn = strategy.netprofit / 1000000.0 * 100.0
profitFactorDelta = baselineAvailable and not na(profitFactor) ? profitFactor - baselineProfitFactor : na
expectancyDelta = baselineAvailable and not na(expectancy) ? expectancy - baselineExpectancy : na
drawdownImprovement = baselineAvailable ? baselineDrawdown - maximumDrawdown : na
comparisonState = not baselineAvailable or na(expectancyDelta) ? "INSUFFICIENT" : expectancyDelta > 0.0 and drawdownImprovement >= 0.0 ? "IMPROVED" : expectancyDelta == 0.0 and drawdownImprovement == 0.0 ? "UNCHANGED" : "WORSE"
promotionState = comparisonState == "IMPROVED" and researchPartition == "HOLDOUT" ? "ALPHA REPLAY CANDIDATE" : "DO NOT PROMOTE"

plot(ema20, "20 EMA", color=color.new(color.blue, 0))
plot(ema50, "50 EMA", color=color.new(color.orange, 0))
plot(resistanceValue, "Resistance", color=color.new(color.red, 55), style=plot.style_linebr)
plot(supportValue, "Support", color=color.new(color.green, 55), style=plot.style_linebr)

var table statePanel = table.new(position.top_right, 2, 4, border_width=1)
var table metricPanel = table.new(position.middle_right, 2, 8, border_width=1)
var table comparisonPanel = table.new(position.bottom_right, 2, 6, border_width=1)
if barstate.islast
    table.cell(statePanel, 0, 0, "Composite Score")
    table.cell(statePanel, 1, 0, str.tostring(compositeScore, "#.0"))
    table.cell(statePanel, 0, 1, "Current Verdict")
    table.cell(statePanel, 1, 1, entrySignalNow ? "RESEARCH ENTRY" : "NO RESEARCH ENTRY")
    table.cell(statePanel, 0, 2, "Setup")
    table.cell(statePanel, 1, 2, ablation)
    table.cell(statePanel, 0, 3, "Entry State")
    table.cell(statePanel, 1, 3, strategy.position_size > 0 ? "ACTIVE" : "FLAT")
    table.cell(metricPanel, 0, 0, "Trades")
    table.cell(metricPanel, 1, 0, str.tostring(closedTrades))
    table.cell(metricPanel, 0, 1, "Win Rate")
    table.cell(metricPanel, 1, 1, na(winRate) ? "unavailable" : str.tostring(winRate, "#.0") + "%")
    table.cell(metricPanel, 0, 2, "Profit Factor")
    table.cell(metricPanel, 1, 2, na(profitFactor) ? "unavailable" : str.tostring(profitFactor, "#.00"))
    table.cell(metricPanel, 0, 3, "Expectancy")
    table.cell(metricPanel, 1, 3, na(expectancy) ? "unavailable" : str.tostring(expectancy, "#.00"))
    table.cell(metricPanel, 0, 4, "Max Drawdown")
    table.cell(metricPanel, 1, 4, str.tostring(maximumDrawdown, "#.00") + "%")
    table.cell(metricPanel, 0, 5, "Net Return")
    table.cell(metricPanel, 1, 5, str.tostring(netReturn, "#.00") + "%")
    table.cell(metricPanel, 0, 6, "Average Winner")
    table.cell(metricPanel, 1, 6, na(averageWinner) ? "unavailable" : str.tostring(averageWinner, "#.00"))
    table.cell(metricPanel, 0, 7, "Average Loser")
    table.cell(metricPanel, 1, 7, na(averageLoser) ? "unavailable" : str.tostring(averageLoser, "#.00"))
    table.cell(comparisonPanel, 0, 0, "Compared to Alpha")
    table.cell(comparisonPanel, 1, 0, comparisonState)
    table.cell(comparisonPanel, 0, 1, "PF Delta")
    table.cell(comparisonPanel, 1, 1, na(profitFactorDelta) ? "unavailable" : str.tostring(profitFactorDelta, "#.00"))
    table.cell(comparisonPanel, 0, 2, "Expectancy Delta")
    table.cell(comparisonPanel, 1, 2, na(expectancyDelta) ? "unavailable" : str.tostring(expectancyDelta, "#.00"))
    table.cell(comparisonPanel, 0, 3, "Drawdown Improvement")
    table.cell(comparisonPanel, 1, 3, na(drawdownImprovement) ? "unavailable" : str.tostring(drawdownImprovement, "#.00"))
    table.cell(comparisonPanel, 0, 4, "Partition")
    table.cell(comparisonPanel, 1, 4, researchPartition)
    table.cell(comparisonPanel, 0, 5, "Recommendation")
    table.cell(comparisonPanel, 1, 5, promotionState)
