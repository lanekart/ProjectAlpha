{
  "name": "iris-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IRIS desktop companion built with Tauri 2, React, and TypeScript.",
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "tsc --noEmit && vite build",
    "build:mac": "tauri build --bundles app,dmg",
    "build:windows": "tauri build --bundles msi,nsis"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.6.0",
    "@tauri-apps/plugin-autostart": "^2.3.0",
    "@tauri-apps/plugin-dialog": "^2.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
