# Project Alpha local environment template.
# Copy to .env locally and fill values there. Never commit real secrets.

UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=
UPSTOX_ACCESS_TOKEN=
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_TOKEN_METADATA_PATH=.alpha/upstox_token_metadata.json
UPSTOX_INSTRUMENT_REGISTRY=
UPSTOX_INSTRUMENT_REGISTRY_VERSION=

ALPHA_REGIME_SHADOW_ENABLED=false
ALPHA_REGIME_SHADOW_CAPTURE_LIVE=false
ALPHA_REGIME_SHADOW_POLICIES=context_only,bearish_only
ALPHA_REGIME_SHADOW_FAILURE_MODE=non_blocking
